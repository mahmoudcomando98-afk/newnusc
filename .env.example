# إعدادات Supabase - انسخ هذا الملف إلى .env وأدخل القيم الحقيقية من مشروعك
# استخدم فقط Project URL وPublishable/anon key المخصصين للواجهة الأمامية.
# لا تضع Service Role Key أو أي سرّ خادمي في هذا الملف أو في الواجهة الأمامية.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
