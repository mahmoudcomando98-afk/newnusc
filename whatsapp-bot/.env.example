# ═══════════════════════════════════════════════════════════
# COMANDO WhatsApp Bot — ملف إعدادات نموذجي
# انسخ este الملف إلى .env وعدل القيم — لا ترفع .env إلى GitHub
# cp .env.example .env
# ═══════════════════════════════════════════════════════════

# رابط المنصة (بدون شرطة مائلة في النهاية)
PLATFORM_URL=https://comando-files.vercel.app

# Supabase — مفتاح secret (قراءة فقط)
# Dashboard → Project Settings → API → service_role key (secret)
# تحذير: ده سري — ما تنشرهوش على GitHub أبداً، .gitignore متضيفاه تلقائي
SUPABASE_URL=https://bmqqacvgtevogcuqfryq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# الجروب المستهدف — املا أحد اختيارين:
# الاسم (بالموافقة — لو في أكثر من واحد هيختار الأول):
TARGET_GROUP_NAME=اسم الجروب هنا
# أو المعرف JID مباشرةً (أدق) — join-group بيملأه تلقائيًا:
# TARGET_GROUP_ID=1234567890-987654321@g.us

# أو عدة مجموعات مفصولة بفواصل (اختياري):
# TARGET_GROUP_NAMES=جروب الشعبة,جروب المتابعة

# رابط دعوة الجروب — ينفع تحط الرابط كامل أو الكود فقط
# يُستخدم مرة واحدة مع: npm run join-group (ثم يكتب TARGET_GROUP_ID تلقائيًا)
# GROUP_INVITE_CODE=1234567890abcdef

# كل كام ثانية البوت يفحص إشعارات جديدة
POLL_INTERVAL_SECONDS=20

# لو الإعلان فيه رابط لملف PDF/صورة → أرسله كملف فعلي على WhatsApp
SEND_MEDIA=true

# الحد الأقصى لطول المحتوى في الرسالة (البقية يُلخَّص)
MAX_CONTENT_CHARS=3500

# عدد مرات إعادة المحاولة لما النت يفصل أو يرفض
MAX_RETRIES=5

# أول تشغيل على الإطلاق: false = يعلّم كل الإعلانات/الإشعارات الموجودة كـ "اتبعتت"
# عشان ما يبعتش 40 رسالة قديمة دفعة واحدة — الوضع الطبيعي
# لو عايز يبعت القديم كمان أول مرة: true
SEND_ON_FIRST_RUN=false

# مسارات مخصصة (اختيارية — للاستضافة على ديسك دائم مثلاً /data)
# AUTH_DIR=/data/.wwebjs_auth
# SENT_STORE_PATH=/data/sent.json
# LOG_DIR=/data/logs

# وضع المطور (اختياري): commando-waha
# DEBUG=commando-waha
